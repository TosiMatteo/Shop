# Variabili per l'esecuzione dei test end-to-end.
#
# Puntano lo stack su un database e una cartella storage dedicati, cosi' il
# reset eseguito da e2e/global-setup.ts (GET /test/reset -> db/testseeds.rb)
# non distrugge i dati di sviluppo. Il database viene creato e migrato in
# automatico da "bin/rails db:prepare" all'avvio del container backend.
#
# Uso:
#   docker compose --env-file .env.e2e --profile e2e up --abort-on-container-exit
#
# Non contiene segreti: e' versionato apposta (vedi l'eccezione in .gitignore).

DATABASE_NAME=backend_e2e
STORAGE_ROOT=tmp/storage_e2e

# Abilita GET /test/reset. Il controller verifica comunque che il
# database in uso abbia il suffisso _e2e prima di cancellare qualcosa.
ENABLE_TEST_HELPERS=true
